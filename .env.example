# Gemini API Key (lấy miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gốc trang quản trị chat (không có /api/v1), dùng xác thực tài khoản app và đặt tour, ví dụ https://chatadmin.benthanhtourist.com
# Tên biến giữ NESTJS_BASE_URL cho khỏi đổi cấu hình; từ 2026-11-16 không còn trỏ về backend e-commerce.
NESTJS_BASE_URL=

# Trang quản trị hội thoại (D:\btt-chat-admin). Bỏ trống thì chatbot chạy độc lập như trước.
# Khoá phải trùng INGEST_API_KEY trong backend/.env bên đó.
ADMIN_CHAT_URL=http://localhost:4000/api/v1
# Địa chỉ trang quản trị mà app, web, Mini App của khách mở được (link ảnh/PDF nhân viên gửi). Bỏ trống thì dùng ADMIN_CHAT_URL.
# Khác ADMIN_CHAT_URL khi chatbot gọi trang quản trị qua mạng nội bộ.
ADMIN_CHAT_PUBLIC_URL=
INGEST_API_KEY=
# Chính database của trang quản trị (cổng 5432): backend bên đó không chạy thì chatbot ghi thẳng lịch sử vào đây.
ADMIN_DATABASE_URL=
