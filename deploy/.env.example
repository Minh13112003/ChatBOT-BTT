# Cấu hình chatbot trên VPS. Copy thành deploy/.env rồi điền. KHÔNG commit file .env.

# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Trang quản trị gọi qua mạng nội bộ Docker (không ra Internet)
ADMIN_CHAT_URL=http://btt-backend-1:4000/api/v1
NESTJS_BASE_URL=http://btt-backend-1:4000
# Địa chỉ công khai của trang quản trị, để khách mở được ảnh/PDF nhân viên gửi
ADMIN_CHAT_PUBLIC_URL=https://chatadmin.benthanhtourist.com/api/v1
# Phải TRÙNG với INGEST_API_KEY trong /opt/btt-chat-admin/deploy/.env
INGEST_API_KEY=
# Database của trang quản trị: backend tắt thì chatbot ghi thẳng vào đây. Thay <DB_PASSWORD> bằng DB_PASSWORD trong /opt/btt-chat-admin/deploy/.env
ADMIN_DATABASE_URL=postgresql://btt:<DB_PASSWORD>@btt-postgres-1:5432/btt

# Website được nhúng khung chat. Để trống = benthanhtourist.com và mọi tên miền con.
NHUNG_CHO_PHEP=
